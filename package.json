{
  "name": "shopping-cart-tests",
  "version": "1.0.0",
  "description": "Comprehensive test suite for Go to Cart button functionality",
  "scripts": {
    "test": "jest --coverage --no-colors",
    "test:watch": "jest --watch --no-colors",
    "test:unit": "jest tests/*.test.js --no-colors",
    "test:e2e": "jest tests/go-to-cart.test.js --no-colors",
    "test:security": "jest tests/security.test.js --no-colors",
    "test:performance": "jest tests/performance.test.js --no-colors",
    "test:coverage": "jest --coverage --coverageReporters=html --no-colors",
    "test:ci": "jest --ci --coverage --maxWorkers=2 --no-colors",
    "serve": "http-server -p 8080 -c-1"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "babel-jest": "^29.5.0",
    "http-server": "^14.1.1",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "puppeteer": "^20.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "js/**/*.js",
      "!js/**/*.test.js",
      "!**/node_modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "moduleFileExtensions": [
      "js",
      "json"
    ],
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  }
}

